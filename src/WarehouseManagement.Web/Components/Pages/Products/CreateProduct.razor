@page "/create-product"
@using WarehouseManagement.Web.Models
@rendermode RenderMode.InteractiveServer

<h3>Create Product</h3>

<form>
    <div class="mb-3">
        <label for="name" class="form-label">Name:</label>
        <input type="text" class="form-control" id="name" @bind-value="product.Name" />
    </div>

    <div class="mb-3">
        <label for="Description" class="form-label">Description:</label>
        <input type="text" class="form-control" id="Description" @bind-value="product.Description" />
    </div>

    <button type="submit" class="btn btn-primary mb-3" @onclick="Save">Save</button>
</form>

@code {
    Product product = new();

    void Save()
    {
        Console.WriteLine($"{product.Name} - {product.Description}");
    }
}
